{
  "name": "data-collection-system",
  "version": "1.0.0",
  "description": "Node.js 数据采集系统界面",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "exe": "python build_python.py",
    "package": "electron-packager . 数据采集系统 --platform=win32 --arch=x64 --out=dist --overwrite --ignore=storage --ignore=build_temp --ignore=dist --ignore=__pycache__ --ignore=.git",
    "build": "npm run exe && npm run package",
    "clean": "rmdir /s /q dist python_dist build_temp 2>nul || true",
    "setup:electron": "npm install electron electron-packager --save-dev"
  },
  "dependencies": {
    "@serialport/parser-readline": "^11.0.1",
    "cors": "^2.8.5",
    "dygraphs": "^2.2.1",
    "express": "^4.19.2",
    "serialport": "^13.0.0",
    "ws": "^8.18.3",
    "zeromq": "^6.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
